# Copy to .env in the repo root and replace every value. NEVER commit .env.
# All values below are FAKE placeholders.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-fake-mysql-root-password
MYSQL_USER=contractiq
MYSQL_PASSWORD=change-me-fake-mysql-password
MYSQL_DATABASE=contractiq
# JDBC URL the backend uses. Compose publishes MySQL on host port 3307 (not 3306).
DB_URL=jdbc:mysql://localhost:3307/contractiq

# MongoDB
MONGO_USER=contractiq
MONGO_PASSWORD=change-me-fake-mongo-password
MONGO_DATABASE=contractiq

# Auth
JWT_SECRET=change-me-fake-jwt-secret-use-a-long-random-string

# Dev-profile demo users (seeder only). FAKE values; set your own in .env.
SEED_UPLOADER_PASSWORD=change-me-fake-uploader-password
SEED_REVIEWER_PASSWORD=change-me-fake-reviewer-password
SEED_ADMIN_PASSWORD=change-me-fake-admin-password

# Anthropic (used only when AI_PROVIDER=claude; the default provider is 'mock' and needs no key)
# AI_PROVIDER=mock
# ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=sk-ant-FAKE-REPLACE-ME
CLAUDE_MODEL=claude-sonnet-5-5
