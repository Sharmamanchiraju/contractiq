<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd">

    <!-- Safe error code shown when an analysis fails (never a raw provider message). -->
    <changeSet id="005-add-contract-analysis-error-code" author="contractiq">
        <addColumn tableName="contracts">
            <column name="analysis_error_code" type="VARCHAR(40)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
